{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "warn"
  },
  "ignorePatterns": [
    "**/node_modules/",
    "**/dist/",
    "**/dist-ssr/",
    "**/coverage/",
    "**/*.min.js",
    "pnpm-lock.yaml",
    "**/test-results/",
    "**/playwright-report/"
  ]
}
