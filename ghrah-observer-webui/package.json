{
  "name": "ghrah-observer-webui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:extension": "./scripts/dev-extension.sh",
    "test:extension": "./scripts/test-extension.sh",
    "build": "./scripts/build.sh",
    "lint": "pnpm --filter @ghrah/observer-web lint:i18n && pnpm --filter @ghrah/observer-web lint:ui-tokens && biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "test": "vitest",
    "type-check": "tsc --noEmit"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.15.0",
  "devDependencies": {
    "@biomejs/biome": "^2.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "@vue/test-utils": "^2.4.11",
    "happy-dom": "^20.10.6",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0",
    "vue": "^3.5.0"
  }
}
