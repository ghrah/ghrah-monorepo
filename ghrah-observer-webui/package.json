{
  "name": "ghrah-observer-webui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "./scripts/dev.sh",
    "dev:extension": "./scripts/dev-extension.sh",
    "test:extension": "./scripts/test-extension.sh",
    "build": "./scripts/build.sh",
    "lint": "pnpm --filter @ghrah/observer-web lint:i18n && pnpm --filter @ghrah/observer-web lint:ui-tokens && biome check .",
    "lint:fix": "biome check . --write",
    "format": "biome format . --write",
    "test": "pnpm -r test",
    "type-check": "pnpm -r type-check"
  },
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {}
}
